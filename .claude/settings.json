{
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } }
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ponytail/hooks/ponytail-activate.js\"", "timeout": 15, "statusMessage": "Loading ponytail mode..." } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ponytail/hooks/ponytail-subagent.js\"", "timeout": 15, "statusMessage": "Loading ponytail mode..." } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/ponytail/hooks/ponytail-mode-tracker.js\"", "timeout": 15, "statusMessage": "Tracking ponytail mode..." } ] }
    ]
  }
}
